<Window x:Class="CoachDesk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CoachDesk.Desktop.Views"
        Title="Coach Desk | Manríquez Gym" Width="1280" Height="760"
        MinWidth="960" MinHeight="580" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="185" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource BrandPrimaryBrush}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="🏋  COACH DESK" Style="{StaticResource SidebarTitleText}" />
                    <Separator Margin="0,10,0,10" Background="#35465D" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Content="▣  Dashboard General" Command="{Binding BackToDashboardCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource PageIsCurrentConverter}, ConverterParameter=Dashboard}" Value="True"><Setter Property="Background" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="#06121F"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="▤  Expediente y Perfil" Command="{Binding OpenAnthropometricCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource PageIsCurrentConverter}, ConverterParameter=Anthropometry}" Value="True"><Setter Property="Background" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="#06121F"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="◉  Gestión de Citas" Command="{Binding OpenAppointmentsCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource PageIsCurrentConverter}, ConverterParameter=Appointments}" Value="True"><Setter Property="Background" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="#06121F"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="⚑  Constructor Rutinas" Command="{Binding OpenRoutinesCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource PageIsCurrentConverter}, ConverterParameter=Routines}" Value="True"><Setter Property="Background" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="#06121F"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="◉  Editor de Dietas" Command="{Binding OpenNutritionCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource PageIsCurrentConverter}, ConverterParameter=Nutrition}" Value="True"><Setter Property="Background" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="#06121F"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Content="↻  Reactivar asesorados" Command="{Binding OpenInactiveAdviseesCommand}" Style="{StaticResource NavButton}" />
                    <Button Content="▮  Cerrar sesión" Command="{Binding LogoutCommand}" Style="{StaticResource NavButton}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="#1D2B3E" BorderBrush="#33445B" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CoachName, StringFormat=Coach Administrador · {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16">
            <views:DashboardView DataContext="{Binding}"
                  Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Dashboard}" />
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Registration}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding NewAdvisee}" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Registrar nuevo asesorado" Style="{StaticResource CardTitleText}" />
                        <TextBlock Text="Crea el expediente administrativo. La cuenta móvil se vincula posteriormente desde Supabase Auth." Margin="0,6,0,24" Style="{StaticResource CardSubtitleText}" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NOMBRE *" Style="{StaticResource FieldLabelText}" />
                                <TextBox Margin="0,6,0,17" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                                <TextBlock Text="SEXO" Style="{StaticResource FieldLabelText}" />
                                <ComboBox Margin="0,6,0,17" SelectedValue="{Binding Sex}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="H" />
                                    <ComboBoxItem Content="M" />
                                </ComboBox>
                                <TextBlock Text="TELÉFONO" Style="{StaticResource FieldLabelText}" />
                                <TextBox Margin="0,6,0,17" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                                <TextBlock Text="OCUPACIÓN" Style="{StaticResource FieldLabelText}" />
                                <TextBox Margin="0,6,0,17" Text="{Binding Occupation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="APELLIDOS *" Style="{StaticResource FieldLabelText}" />
                                <TextBox Margin="0,6,0,17" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                                <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource FieldLabelText}" />
                                <DatePicker Margin="0,6,0,17" SelectedDate="{Binding BirthDate}" />
                                <TextBlock Text="INICIO DE ASESORÍA" Style="{StaticResource FieldLabelText}" />
                                <DatePicker Margin="0,6,0,17" SelectedDate="{Binding CoachingStartDate}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="OBJETIVO" Style="{StaticResource FieldLabelText}" />
                        <TextBox Margin="0,6,0,20" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                        <Border Background="#5D2632" CornerRadius="5" Padding="11" Margin="0,0,0,14" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Message}" Foreground="#FFD9DC" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Guardar expediente" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Limpiar" Command="{Binding ClearCommand}" Margin="10,0,0,0" Style="{StaticResource QuickActionButton}" />
                            <ProgressBar Width="90" Height="5" Margin="18,18,0,0" IsIndeterminate="True" Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=InactiveAdvisees}">
                <Grid DataContext="{Binding InactiveAdvisees}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Asesorados suspendidos y dados de baja" Style="{StaticResource CardTitleText}"/><TextBlock Text="Selecciona un expediente para reactivar su servicio sin perder su historial." Margin="0,5,0,14" Style="{StaticResource CardSubtitleText}"/></StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Advisees}" SelectedItem="{Binding SelectedAdvisee}" Style="{StaticResource AdviseeListBox}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Background="#5D2632" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#FFD9DC" FontSize="11" FontWeight="Bold"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Message}" Foreground="#FFB4BA" VerticalAlignment="Center" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="Reactivar servicio" Command="{Binding ReactivateCommand}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"/></Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Anthropometry}">
                <views:AnthropometricRecordView DataContext="{Binding AnthropometricRecord}" />
            </Border>
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Nutrition}">
                <views:DietPlanView DataContext="{Binding DietPlan}" />
            </Border>
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Appointments}">
                <views:AppointmentsView DataContext="{Binding AppointmentManager}" />
            </Border>
            <Border Grid.Row="1" Margin="0" Style="{StaticResource ContentCard}"
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Routines}">
                <views:RoutineBuilderView DataContext="{Binding RoutineBuilder}" />
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
