<UserControl x:Class="CoachDesk.Desktop.Views.AppointmentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Administración de Citas para Asesorías" Style="{StaticResource SelectedAdviseeNameText}" /><TextBlock Text="Publica cualquier horario libre para que los alumnos lo aparten desde su móvil." Style="{StaticResource CardSubtitleText}" /></StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,18" Style="{StaticResource AccentPanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="+ Publicar nuevo horario" Foreground="{StaticResource BrandAccentBrush}" FontWeight="Bold" /><Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Fecha" Style="{StaticResource FieldLabelText}" /><TextBox Text="17/09/2026" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hora exacta (libre)" Style="{StaticResource FieldLabelText}" /><TextBox Text="Ej: 06:00 PM" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Motivo o lugar" Style="{StaticResource FieldLabelText}" /><TextBox Text="Ej: Toma de pliegues gym" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="3" Content="Publicar horario" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" /></Grid></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource InnerPanel}"><StackPanel><TextBlock Text="Horarios publicados en el sistema" Style="{StaticResource CardTitleText}" /><Grid Margin="0,13,0,0" Height="32" Background="#0E1729"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Fecha" Style="{StaticResource TableHeaderText}" /><TextBlock Grid.Column="1" Text="Hora asignada" Style="{StaticResource TableHeaderText}" /><TextBlock Grid.Column="2" Text="Detalle" Style="{StaticResource TableHeaderText}" /><TextBlock Grid.Column="3" Text="Asignado a" Style="{StaticResource TableHeaderText}" /><TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource TableHeaderText}" /><TextBlock Grid.Column="5" Text="Acción" Style="{StaticResource TableHeaderText}" /></Grid><Grid Height="38" Background="#1E2E43"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Sábado 12 Sep, 2026" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="1" Text="10:30 AM" Style="{StaticResource AccentTableCellText}" /><TextBlock Grid.Column="2" Text="Toma de pliegues y perímetros" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="3" Text="Carlos Ruiz" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="4" Text="Ocupado" Foreground="#55D17A" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="5" Text="Cancelar" Foreground="#FF6674" Style="{StaticResource TableCellText}" /></Grid><Grid Height="38" Background="#1A283B"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Lunes 14 Sep, 2026" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="1" Text="07:45 PM" Style="{StaticResource AccentTableCellText}" /><TextBlock Grid.Column="2" Text="Ajuste de técnica y pesos" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="3" Text="-- Libre --" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="4" Text="Disponible" Foreground="#FFBF55" Style="{StaticResource TableCellText}" /><TextBlock Grid.Column="5" Text="Eliminar" Foreground="#FF6674" Style="{StaticResource TableCellText}" /></Grid></StackPanel></Border>
    </Grid>
</UserControl>
