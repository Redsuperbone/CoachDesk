<UserControl x:Class="CoachDesk.Desktop.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Administración de Citas para Asesorías" Style="{StaticResource SelectedAdviseeNameText}" />
            <TextBlock Text="Publica horarios libres y evita traslapes antes de ponerlos a disposición de los asesorados." Style="{StaticResource CardSubtitleText}" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,18" Style="{StaticResource AccentPanel}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="+ Publicar nuevo horario" Foreground="{StaticResource BrandAccentBrush}" FontWeight="Bold" />
                <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Fecha" Style="{StaticResource FieldLabelText}" /><DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hora (24 h)" Style="{StaticResource FieldLabelText}" /><TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Min." Style="{StaticResource FieldLabelText}" /><TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Motivo o lugar" Style="{StaticResource FieldLabelText}" /><TextBox Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,5,0,0" /></StackPanel>
                    <Button Grid.Column="4" Content="Publicar horario" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding ErrorMessage}" Foreground="#FF9FA6" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource InnerPanel}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><TextBlock Text="Horarios publicados en el sistema" Style="{StaticResource CardTitleText}" /><Button Content="Actualizar" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Style="{StaticResource QuickActionButton}" /></Grid>
                <DataGrid Grid.Row="1" Margin="0,13,0,10" ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource FoodDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="*" /><DataGridTextColumn Header="Hora asignada" Binding="{Binding Time}" Width="*" /><DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="1.4*" /><DataGridTextColumn Header="Asignado a" Binding="{Binding AdviseeName}" Width="1.2*" /><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="*" /><DataGridTextColumn Header="Acción" Binding="{Binding ActionLabel}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2"><TextBlock Text="{Binding SuccessMessage}" Foreground="#6BE19A" VerticalAlignment="Center" Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Content="Cancelar / eliminar seleccionado" Command="{Binding CancelOrDeleteCommand}" HorizontalAlignment="Right" Style="{StaticResource QuickActionButton}" /></Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
