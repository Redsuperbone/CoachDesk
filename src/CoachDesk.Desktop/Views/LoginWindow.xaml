
<Window x:Class="CoachDesk.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CoachDesk.Desktop.Helpers"
        Title="Iniciar sesión | Coach Desk"
        Width="980"
        Height="610"
        MinWidth="820"
        MinHeight="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo -->
        <Border Grid.Column="0"
                Background="{StaticResource BrandPrimaryBrush}"
                Padding="58">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="MANRÍQUEZ GYM"
                           Style="{StaticResource LoginBrandText}" />

                <TextBlock Text="Coach Desk"
                           Style="{StaticResource LoginProductText}" />

                <Border Width="55"
                        Height="4"
                        Background="{StaticResource BrandAccentBrush}"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0" />

                <TextBlock Margin="0,28,0,0"
                           Text="Gestiona el progreso deportivo y nutricional de tus asesorados desde un solo lugar."
                           Style="{StaticResource LoginDescriptionText}"
                           TextWrapping="Wrap" />

            </StackPanel>
        </Border>

        <!-- Panel de inicio de sesión -->
        <Grid Grid.Column="1" Margin="58">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Bienvenido"
                           Style="{StaticResource LoginTitleText}" />

                <TextBlock Text="Ingresa tus credenciales para continuar."
                           Style="{StaticResource PageDescriptionText}"
                           Margin="0,5,0,0" />

                <!-- Correo -->
                <TextBlock Text="Correo electrónico"
                           Style="{StaticResource FieldLabelText}"
                           Margin="0,35,0,6" />

                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         AutomationProperties.Name="Correo electrónico" />

                <!-- Contraseña -->
                <TextBlock Text="Contraseña"
                           Style="{StaticResource FieldLabelText}"
                           Margin="0,20,0,6" />

                <PasswordBox helpers:PasswordBoxHelper.IsPasswordBindingEnabled="True"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputPasswordBox}"
                             AutomationProperties.Name="Contraseña" />

                <!-- Mensaje de error -->
                <Border Background="#FFF5E7"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,18,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#9A5500"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Botón -->
                <Button Content="Iniciar sesión"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,28,0,0" />

                <TextBlock Text="Acceso exclusivo para el personal autorizado."
                           Style="{StaticResource LoginHintText}"
                           Margin="0,25,0,0"
                           TextAlignment="Center" />

            </StackPanel>

            <!-- Indicador de carga -->
            <Border Background="#B3FFFFFF"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <ProgressBar IsIndeterminate="True"
                                 Width="170"
                                 Height="5" />

                    <TextBlock Text="Validando credenciales..."
                               Margin="0,14,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
