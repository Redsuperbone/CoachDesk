<UserControl x:Class="CoachDesk.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Dashboard General" Style="{StaticResource CardTitleText}" />
        <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource InnerPanel}" Padding="14,10"><StackPanel><TextBlock Text="ASESORADOS ACTIVOS" Style="{StaticResource FieldLabelText}"/><TextBlock Text="{Binding AdviseeSelector.ActiveCount}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource InnerPanel}" Padding="14,10"><StackPanel><TextBlock Text="CITAS PROGRAMADAS (SEMANA)" Style="{StaticResource FieldLabelText}"/><TextBlock Text="{Binding ScheduledAppointmentsThisWeek}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource InnerPanel}" Padding="14,10"><StackPanel><TextBlock Text="REVISIONES PENDIENTES" Style="{StaticResource FieldLabelText}"/><TextBlock Text="{Binding PendingReviews}" FontSize="25" FontWeight="Bold" Foreground="#F5B642" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource InnerPanel}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Asesorados activos" Style="{StaticResource CardTitleText}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↻" Command="{Binding AdviseeSelector.ReloadCommand}" Style="{StaticResource IconButton}" ToolTip="Actualizar"/><Button Content="Ver expedientes" Command="{Binding OpenAnthropometricCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/></StackPanel></Grid>
                <DataGrid Grid.Row="1" Margin="0,10,0,8" ItemsSource="{Binding AdviseeSelector.Advisees}" SelectedItem="{Binding AdviseeSelector.SelectedAdvisee}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource FoodDataGrid}">
                    <DataGrid.Columns><DataGridTextColumn Header="Asesorado" Binding="{Binding FullName}" Width="2*"/><DataGridTextColumn Header="Teléfono" Binding="{Binding PhoneNumber}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/></DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="{Binding DashboardMessage}" Foreground="#FFB4BA" Visibility="{Binding HasDashboardMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
