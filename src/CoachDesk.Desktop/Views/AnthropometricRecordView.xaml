<UserControl x:Class="CoachDesk.Desktop.Views.AnthropometricRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Advisee.FullName}" Style="{StaticResource SelectedAdviseeNameText}" />
                <TextBlock Text="Captura y compara las mediciones del mes 1 al mes 10."
                           Style="{StaticResource CardSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Volver"
                    Command="{Binding DataContext.BackToDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource QuickActionButton}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,14">
            <Border Background="#FFF5E7" CornerRadius="5" Padding="10"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A5500" TextWrapping="Wrap" />
            </Border>
            <Border Background="#E4F3EA" CornerRadius="5" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#1D6A3A" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,0,0,14" Padding="14" Style="{StaticResource InnerPanel}">
            <Grid DataContext="{Binding Photos}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Fotografías de control" Style="{StaticResource CardTitleText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="MES DE EVIDENCIA:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource FieldLabelText}"/>
                        <ListBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Height="34" BorderThickness="0" Background="Transparent" ToolTip="Selecciona el mes para ver o cargar las fotografías correspondientes">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="#0E1729"/><Setter Property="BorderBrush" Value="#32445C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,3,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D5879"/><Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263A53"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SelectedMonthLabel}" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Top" Margin="0,11,12,0"/>
                    <Button Command="{Binding OpenPreviewCommand}" CommandParameter="{Binding FrontalPhoto}" IsEnabled="{Binding HasFrontalPhoto}" Background="#111C30" BorderBrush="#3A5473" Foreground="{StaticResource BrandAccentBrush}" BorderThickness="1" Padding="6" Margin="0,0,8,0" ToolTip="Ver fotografía frontal"><StackPanel Width="118"><Image Source="{Binding FrontalPhoto.Preview}" Height="92" Stretch="UniformToFill" Visibility="{Binding HasFrontalPhoto, Converter={StaticResource BooleanToVisibilityConverter}}"/><Border Height="92" Background="#18263A" Visibility="{Binding HasFrontalPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><TextBlock Text="No recibida" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Frontal" Margin="0,5,0,0" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Command="{Binding OpenPreviewCommand}" CommandParameter="{Binding ProfilePhoto}" IsEnabled="{Binding HasProfilePhoto}" Background="#111C30" BorderBrush="#3A5473" Foreground="{StaticResource BrandAccentBrush}" BorderThickness="1" Padding="6" Margin="0,0,8,0" ToolTip="Ver fotografía de perfil"><StackPanel Width="118"><Image Source="{Binding ProfilePhoto.Preview}" Height="92" Stretch="UniformToFill" Visibility="{Binding HasProfilePhoto, Converter={StaticResource BooleanToVisibilityConverter}}"/><Border Height="92" Background="#18263A" Visibility="{Binding HasProfilePhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><TextBlock Text="No recibida" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Perfil" Margin="0,5,0,0" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Command="{Binding OpenPreviewCommand}" CommandParameter="{Binding BackPhoto}" IsEnabled="{Binding HasBackPhoto}" Background="#111C30" BorderBrush="#3A5473" Foreground="{StaticResource BrandAccentBrush}" BorderThickness="1" Padding="6" ToolTip="Ver fotografía de espalda"><StackPanel Width="118"><Image Source="{Binding BackPhoto.Preview}" Height="92" Stretch="UniformToFill" Visibility="{Binding HasBackPhoto, Converter={StaticResource BooleanToVisibilityConverter}}"/><Border Height="92" Background="#18263A" Visibility="{Binding HasBackPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><TextBlock Text="No recibida" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Espalda" Margin="0,5,0,0" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="0,130,0,0" Foreground="#FFB4BA" FontSize="11" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="{Binding IsLoading}"
                      FrozenColumnCount="1"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      Style="{StaticResource AnthropometryDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Medición" Binding="{Binding Name}" IsReadOnly="True" Width="190" />
                    <DataGridTextColumn Header="Mes 1" Binding="{Binding Month1, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 2" Binding="{Binding Month2, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 3" Binding="{Binding Month3, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 4" Binding="{Binding Month4, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 5" Binding="{Binding Month5, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 6" Binding="{Binding Month6, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 7" Binding="{Binding Month7, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 8" Binding="{Binding Month8, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 9" Binding="{Binding Month9, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Mes 10" Binding="{Binding Month10, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat={}{0:0.##}}" Width="90" />
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" IsReadOnly="True" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Background="#D9FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="5" />
                    <TextBlock Text="Cargando expediente..." Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="Rangos biológicos validados: peso 25–350 kg, estatura 100–250 cm; pliegues y perímetros según la fila."
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            <Button Content="Guardar expediente"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Width="180" />
        </Grid>
    </Grid>
</UserControl>
