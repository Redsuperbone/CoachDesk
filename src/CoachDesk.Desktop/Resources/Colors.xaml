<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CoachDesk.Desktop.Converters">
    <Color x:Key="BrandPrimaryColor">#1D2B3E</Color><Color x:Key="BrandAccentColor">#3AB8F2</Color><Color x:Key="SurfaceColor">#080D16</Color><Color x:Key="CardColor">#1C2A3D</Color><Color x:Key="InputColor">#0E1729</Color><Color x:Key="TextPrimaryColor">#F4F7FB</Color><Color x:Key="TextSecondaryColor">#94A7C2</Color><Color x:Key="LineColor">#32445C</Color>
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" /><SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" /><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" /><SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" /><SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" /><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" /><SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" /><SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /><local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" /><local:PageToVisibilityConverter x:Key="PageToVisibilityConverter" />
</ResourceDictionary>
